{
  "name": "my-life-manager",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "My Life Manager - private, offline personal life manager for Android",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:test": "vite build --mode test --outDir dist-test",
    "test": "vitest run",
    "sync": "npm run build && npx cap sync android",
    "audit:deps": "npm audit --omit=dev"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "hash-wasm": "^4.12.0",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@types/node": "^26.6.6",
    "fake-indexeddb": "^6.2.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
